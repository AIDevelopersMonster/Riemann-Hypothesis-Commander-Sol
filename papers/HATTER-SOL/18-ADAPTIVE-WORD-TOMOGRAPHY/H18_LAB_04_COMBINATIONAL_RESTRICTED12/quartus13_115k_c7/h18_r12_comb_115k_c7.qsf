# H18-LAB-04 combinational restricted-12 matched H17 large-device benchmark.
# Same device as the already-characterized H17-LAB-02 115K control.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY h18_r12_comb_controller
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SYSTEMVERILOG_FILE ../generated_comb/psl27_membership_only.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../generated_comb/psl27_member_class_only.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../generated_comb/h18_r12_comb_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../generated_comb/h18_r12_comb_controller.sv
set_global_assignment -name SDC_FILE h18_r12_comb_115k_c7.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
